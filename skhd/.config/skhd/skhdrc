# Basic focus windows
# alt - h: yabai -m window --focus west
# alt - l: yabai -m window --focus east
alt - h : sh $HOME/.config/yabai/focus_window_cycle_west.sh
alt - l : sh $HOME/.config/yabai/focus_window_cycle_east.sh
alt - j: yabai -m window --focus south
alt - k: yabai -m window --focus north

alt - r: yabai -m space --rotate 90


# Basic move windows
shift + alt - h : yabai -m window --warp west
shift + alt - j : yabai -m window --warp south
shift + alt - k : yabai -m window --warp north
shift + alt - l : yabai -m window --warp east

# Resize windows
ctrl + alt - h : ~/.config/yabai/resize_window.sh -h
ctrl + alt - l : ~/.config/yabai/resize_window.sh -l

# change split height
ctrl + alt - k : ~/.config/yabai/resize_window.sh -u
ctrl + alt - j : ~/.config/yabai/resize_window.sh -d

# Reset windows space size
ctrl + alt - space: yabai -m space --balance

